# ---------------------------------------------------------------------------
# Kinetix Algo — environment template. Copy to .env and fill in.
# Everything here has a safe default: with no .env at all the platform runs
# entirely on the deterministic simulator.
# ---------------------------------------------------------------------------

# --- core -------------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# Seeds every generated candle series and every simulated fill. Same seed =>
# byte-identical history, which is what makes backtests reproducible.
SIM_SEED=1337

# Simulated live tick rate (Hz) pushed over the WebSocket market channel.
SIM_TICK_HZ=4

# SQLite file (created on first boot, migrated + seeded automatically).
DATABASE_PATH=./data/kinetix.db

# --- market data provider ---------------------------------------------------
# simulated | kotakneo
#   simulated -> deterministic synthetic candles/ticks, no credentials needed
#   kotakneo  -> live/historical data from Kotak Neo Trade API (India)
MARKET_PROVIDER=simulated

# --- execution venue --------------------------------------------------------
# simulated | kotakneo
#   Keep this `simulated` until you have verified the Kotak Neo flow against a
#   real account. Order placement hits a live brokerage account when this is
#   `kotakneo`.
EXECUTION_VENUE=simulated

# ---------------------------------------------------------------------------
# Kotak Neo Trade API (https://www.kotaksecurities.com)
# Required only when MARKET_PROVIDER or EXECUTION_VENUE is set to `kotakneo`.
# Get the consumer key from the Kotak Neo developer portal.
# ---------------------------------------------------------------------------
KOTAK_NEO_CONSUMER_KEY=
KOTAK_NEO_CONSUMER_SECRET=

# Login identifiers. KOTAK_NEO_MOBILE is the 10-digit login mobile number,
# KOTAK_NEO_UCC is the client code / UCC shown in the Neo app.
KOTAK_NEO_MOBILE=
KOTAK_NEO_UCC=
KOTAK_NEO_MPIN=

# TOTP. Either supply the base32 secret and let the server generate the
# 6-digit code, or supply a pre-generated code (it expires in ~30s).
KOTAK_NEO_TOTP_SECRET=
KOTAK_NEO_TOTP_CODE=

# Override only if Kotak changes hosts/versions.
KOTAK_NEO_BASE_URL=https://neoapi.kotaksecurities.com
KOTAK_NEO_API_VERSION=1.0
