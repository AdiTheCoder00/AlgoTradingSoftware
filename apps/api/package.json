{
  "name": "@kinetix/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kinetix Algo engine: market simulator, execution, portfolio, risk, fleet, backtests, Kotak Neo broker adapter, REST + WebSocket API.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env src/server.ts",
    "seed": "node --env-file-if-exists=../../.env src/db/seedCli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.3.4",
    "@kinetix/shared": "*",
    "fastify": "^5.12.5",
    "pino": "^9.14.0",
    "zod": "^4.6.5"
  }
}
